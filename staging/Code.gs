// Isolated counting test deployment only. Add count-submission-r2.gs as a second file.
var API_VERSION='OH_STORE_HUB_V8';
function getSpreadsheet_(){var id=PropertiesService.getScriptProperties().getProperty('TEST_SPREADSHEET_ID');if(!id||id==='1OyoRne2_qryU0K9k3fXo8sUufWS_wQmpGBSwPhUjlB0')throw Error('A separate test spreadsheet is required');return SpreadsheetApp.openById(id)}
function jsonOutput_(data){return ContentService.createTextOutput(JSON.stringify(data)).setMimeType(ContentService.MimeType.JSON)}
function doGet(e){try{var p=e.parameter||{},mode=String(p.mode||'daily');if(mode==='countSubmissionStatus')return jsonOutput_(countSubmissionStatus_(String(p.submissionId||'')));if(mode!=='daily'&&mode!=='weekly')throw Error('Test mode only');return jsonOutput_([{id:mode==='daily'?'TEST-DAILY-A':'TEST-WEEKLY-A',name:'SYNTHETIC ONLY',category:'TEST ONLY',unit:'g',count_type:'both',tare:0}])}catch(error){return jsonOutput_({status:'error',message:String(error.message||error)})}}
function doPost(e){var lock=LockService.getScriptLock();try{lock.waitLock(30000);var data=JSON.parse(e.postData.contents||'{}');if(data.mode!=='daily'&&data.mode!=='weekly')throw Error('Test counting mode only');return jsonOutput_(saveCount_(data.mode,data.items,String(data.submissionId||'')))}catch(error){return jsonOutput_({status:'error',message:String(error.message||error)})}finally{try{lock.releaseLock()}catch(ignore){}}}
